# Configure como variáveis de runtime na hospedagem; nunca insira chaves reais aqui.
ADMIN_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Definir 1 somente após validar entrega de eventos assinados no endpoint publicado.
STRIPE_WEBHOOK_READY=0
# Assinaturas: habilitar somente após homologar cobrança, cancelamentos e eventos de risco.
STRIPE_SUBSCRIPTIONS_READY=0

# Opcionais: acesso por e-mail (Clerk) e avisos transacionais (Resend).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# Opcional: explicações de estudo por IA (modelo obtido no catálogo atual do provedor).
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
